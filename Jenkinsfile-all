pipeline {
    agent any

    environment {
        TF_TOKEN_app_terraform_io = credentials('tfc-token')
    }

    stages {
        stage('Deploy Network') {
            steps {
                script {
                    dir("infrastructure_aws/network") {

                        sh 'rm -rf .terraform .terraform.lock.hcl'
                        sh 'terraform init'
                        sh 'terraform apply -auto-approve'
                    }
                }
            }
        }

        stage('Deploy Server') {
            steps {
                script {
                    dir("infrastructure_aws/server") {

                        sh 'rm -rf .terraform .terraform.lock.hcl'
                        sh 'terraform init'
                        sh 'terraform apply -auto-approve --var-file "terraform.tfvars" -var="image_tag=${IMAGE_TAG}"'
                    }
                }
            }
        }

        stage('Deploy Client') {
            steps {
                script {
                    dir("infrastructure_aws/client") {

                        sh 'rm -rf .terraform .terraform.lock.hcl'
                        sh 'terraform init'
                        sh 'terraform apply -auto-approve --var-file "terraform.tfvars" -var="image_tag=${IMAGE_TAG}"'
                    }
                }
            }
        }
    }
}
