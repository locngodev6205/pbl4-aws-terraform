pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTIVE_COLOR',
            choices: ['blue', 'green'],
            description: 'Chọn màu đang ACTIVE cho client (ALB sẽ trỏ về màu này)'
        )
    }

    stages {
        stage('Switch ALB via Route53') {
            steps {
                withCredentials([string(credentialsId: 'tfc-token', variable: 'TF_TOKEN_app_terraform_io')]) {
                    dir('infrastructure_aws/dns-routing') {
                        sh '''#!/usr/bin/env bash
                            set -e

                            echo "Switching active_color to: ${ACTIVE_COLOR}"

                            terraform init -input=false
                            terraform apply -auto-approve -var="active_color=${ACTIVE_COLOR}"
                        '''
                    }
                }
            }
        }
    }
}
