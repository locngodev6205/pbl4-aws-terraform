pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTIVE_COLOR_WEB',
            choices: ['blue', 'green'],
            description: 'Chọn màu đang ACTIVE cho web (ALB sẽ trỏ về màu này)'
        )
        choice(
            name: 'ACTIVE_COLOR_APP',
            choices: ['blue', 'green'],
            description: 'Chọn màu đang ACTIVE cho app (ALB sẽ trỏ về màu này)'
        )
    }

    stages {
        stage('Switch ALB via Route53') {
            steps {
                withCredentials([string(credentialsId: 'tfc-token', variable: 'TF_TOKEN_app_terraform_io')]) {
                    dir('infrastructure_aws/dns-routing') {
                        sh '''#!/usr/bin/env bash
                            set -e

                            echo "Switching active_color_web to: ${ACTIVE_COLOR_WEB} and active_color_app to: ${ACTIVE_COLOR_APP}"

                            terraform init -input=false
                            terraform apply -auto-approve -var="active_color_web=${ACTIVE_COLOR_WEB}" -var="active_color_app=${ACTIVE_COLOR_APP}"
                        '''
                    }
                }
            }
        }
    }
}
